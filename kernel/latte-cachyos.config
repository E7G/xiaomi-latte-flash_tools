# CachyOS-derived settings adapted for Mi Pad 2 (Cherry Trail/Airmont, 2 GiB RAM).
# Applied on top of linux_latte's xiaomipad2_defconfig.
CONFIG_LOCALVERSION="-latte-cachyos"
# CONFIG_LOCALVERSION_AUTO is not set

# Airmont is compatible with the Silvermont compiler target.
# CONFIG_MATOM is not set
CONFIG_MSILVERMONT=y

# CachyOS performance/latency settings, balanced for a low-power tablet.
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE_O3=y
CONFIG_PREEMPT_BUILD=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_SCHED_BORE=y
CONFIG_SCHED_AUTOGROUP=y
# CONFIG_HZ_100 is not set
# CONFIG_HZ_250 is not set
CONFIG_HZ_300=y
# CONFIG_HZ_500 is not set
# CONFIG_HZ_600 is not set
# CONFIG_HZ_750 is not set
# CONFIG_HZ_1000 is not set
CONFIG_HZ=300
CONFIG_NO_HZ_IDLE=y
# CONFIG_NO_HZ_FULL is not set

# eMMC-friendly scheduling and responsive memory reclaim.
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_ADIOS=y
CONFIG_IOSCHED_BFQ=y
CONFIG_BFQ_GROUP_IOSCHED=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set

# Low-memory tablet: compressed RAM, ThinLTO, compressed modules.
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MEMORY_TRACKING=y
CONFIG_LTO_CLANG_THIN=y
CONFIG_MODULE_COMPRESS=y
CONFIG_MODULE_COMPRESS_ZSTD=y
CONFIG_MODULE_DECOMPRESS=y

# schedutil works well with Cherry Trail's bursty tablet workload.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_X86_INTEL_PSTATE=y

