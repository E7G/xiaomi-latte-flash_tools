#!/usr/bin/env bash
set -u

CPUROOT=/sys/devices/system/cpu
last_state=-1

read_temp() {
    local thermal_root=$1 hwmon_root=$2
    local -n temperature_result=$3
    local zone hwmon type sample sensor max=0
    local -a sensors=()

    for zone in "$thermal_root"/thermal_zone*; do
        IFS= read -r type 2>/dev/null < "$zone/type" || continue
        case "$type" in
            PNIT|soc_dts0|soc_dts1|x86_pkg_temp*|pkg_temp*)
                sensors+=("$zone/temp")
                ;;
        esac
    done

    for hwmon in "$hwmon_root"/hwmon*; do
        IFS= read -r type 2>/dev/null < "$hwmon/name" || continue
        [ "$type" = "coretemp" ] || continue
        sensors+=("$hwmon"/temp*_input)
    done

    for sensor in "${sensors[@]}"; do
        IFS= read -r sample 2>/dev/null < "$sensor" || continue
        case "$sample" in ''|*[!0-9]*) continue ;; esac
        if [ "$sample" -gt "$max" ] && [ "$sample" -lt 120000 ]; then
            max=$sample
        fi
    done
    temperature_result=$max
}

# Escalate to the required ceiling in this poll, not one state per poll.
# Cooling remains one step at a time with the original hysteresis thresholds.
next_state() {
    local state=${1-} t=${2-}
    local -n state_result=$3
    case "$state" in 0|1|2|3) ;; *) return 2 ;; esac
    case "$t" in ''|*[!0-9]*) return 2 ;; esac
    [ "$t" -gt 0 ] && [ "$t" -lt 120000 ] || return 2

    if [ "$t" -ge 80000 ]; then
        state=3
    elif [ "$t" -ge 74000 ] && [ "$state" -lt 2 ]; then
        state=2
    elif [ "$t" -ge 67000 ] && [ "$state" -lt 1 ]; then
        state=1
    else
        case "$state" in
            1) [ "$t" -le 61000 ] && state=0 ;;
            2) [ "$t" -le 68000 ] && state=1 ;;
            3) [ "$t" -le 74000 ] && state=2 ;;
        esac
    fi
    state_result=$state
}

apply_state() {
    local state=$1 maxfreq label f
    case "$state" in
        0) maxfreq=2240000; label="cool/full";;
        1) maxfreq=1840000; label="warm";;
        2) maxfreq=1600000; label="hot";;
        3) maxfreq=1330000; label="very-hot";;
    esac
    for f in "$CPUROOT"/cpu[0-9]*/cpufreq/scaling_max_freq; do
        [ -w "$f" ] && printf '%s\n' "$maxfreq" > "$f"
    done
    logger -t mipad2-thermal "state=$state ($label) cpu_max=$maxfreq kHz"
}

cleanup() {
    local f
    for f in "$CPUROOT"/cpu[0-9]*/cpufreq/scaling_max_freq; do
        [ -w "$f" ] && printf '%s\n' 2240000 > "$f"
    done
}
trap cleanup EXIT
trap 'exit 0' TERM INT

state=0
while :; do
    read_temp /sys/class/thermal /sys/class/hwmon t
    if [ "$t" -le 0 ]; then
        sleep 3
        continue
    fi

    next_state "$state" "$t" new_state || { sleep 3; continue; }
    state=$new_state

    if [ "$state" -ne "$last_state" ]; then
        apply_state "$state"
        last_state=$state
    fi
    sleep 3
done
