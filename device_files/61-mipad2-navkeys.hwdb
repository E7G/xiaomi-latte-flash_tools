# FocalTech bezel keys: same mapping as systemd's FTSC1000:00 record.
# Software-enumerated touch controller in the 7.2 Mi Pad 2 kernel.
evdev:name:hid-over-i2c 2808:509C Keyboard:dmi:*:svnXiaomiInc:pnMipad2:*
 KEYBOARD_KEY_700e0=reserved
 KEYBOARD_KEY_700e3=reserved
 KEYBOARD_KEY_70016=menu
 KEYBOARD_KEY_70029=leftmeta
 KEYBOARD_KEY_7002a=back
