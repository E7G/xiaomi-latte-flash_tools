[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = linux-latte-cachyos
Target = linux-latte-integrated
Target = linux-latte-integrated-7-2
Target = linux-latte-integrated-7-2-daily3
Target = linux-latte-integrated-7-2-adc1
Target = linux-latte-integrated-7-2-adc2
Target = linux-latte-integrated-7-2-lpat9
Target = linux-latte-integrated-7-2-lpat30
Target = linux-latte-integrated-7-2-lpat31

[Action]
Description = Install and sign linux_latte kernel
When = PostTransaction
Exec = /usr/local/sbin/mipad2-kernel-install
Depends = sbsigntools
NeedsTargets
