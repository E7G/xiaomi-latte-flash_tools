#!/usr/bin/env bash
set -Eeuo pipefail

# The pacman pre-transaction hook protects normal upgrades. Keep the same
# check here so a manual invocation cannot replace a signed kernel either.
/usr/local/sbin/mipad2-kernel-preflight

pkgbase="linux-latte-cachyos"
boot_image="/boot/vmlinuz-linux-latte-cachyos"
mok_key="/etc/mipad2-secureboot/MOK.key"
mok_cert="/boot/EFI/MOK.crt"

mapfile -t owned_images < <(
  pacman -Ql "${pkgbase}" \
    | awk '$2 ~ "^/usr/lib/modules/[^/]+/vmlinuz$" { print $2 }'
)

matches=()
for candidate in "${owned_images[@]}"; do
  [[ -s "${candidate}" ]] || continue
  matches+=("${candidate}")
done

if (( ${#matches[@]} != 1 )); then
  echo "Expected exactly one pacman-owned ${pkgbase} kernel image, found ${#matches[@]}" >&2
  printf 'Owned candidates: %s\n' "${owned_images[*]:-(none)}" >&2
  exit 1
fi

source_image="${matches[0]}"
echo "Using $(pacman -Q "${pkgbase}") kernel image: ${source_image}"
tmp_image="${boot_image}.new"
trap 'rm -f "${tmp_image}"' EXIT

if [[ -s "${mok_key}" && -s "${mok_cert}" ]]; then
  /usr/bin/sbsign \
    --key "${mok_key}" \
    --cert "${mok_cert}" \
    --output "${tmp_image}" \
    "${source_image}"
  /usr/bin/sbverify --cert "${mok_cert}" "${tmp_image}" >/dev/null
  echo "Installed and signed ${source_image} -> ${boot_image}"
else
  install -m 0755 "${source_image}" "${tmp_image}"
  echo "No private MOK provisioned; installed unsigned kernel -> ${boot_image}"
fi

chmod 0755 "${tmp_image}"
mv -f "${tmp_image}" "${boot_image}"
trap - EXIT
