#!/usr/bin/env bash
set -Eeuo pipefail

# The pacman pre-transaction hook protects normal upgrades. Keep the same
# check here so a manual invocation cannot replace a signed kernel either.
/usr/local/sbin/mipad2-kernel-preflight

mok_key="/etc/mipad2-secureboot/MOK.key"
mok_cert="/boot/EFI/MOK.crt"

# ALPM NeedsTargets passes every upgraded package on stdin. Manual invocations
# may supply explicit supported bases; an ambiguous no-argument install fails.
targets=("$@")
if (( ${#targets[@]} == 0 )) && [[ ! -t 0 ]]; then
  while IFS= read -r target; do
    [[ -z "$target" ]] || targets+=("$target")
  done
fi
if (( ${#targets[@]} == 0 )); then
  for candidate_base in linux-latte-cachyos linux-latte-integrated linux-latte-integrated-7-2; do
    if pacman -Qq "$candidate_base" >/dev/null 2>&1; then targets+=("$candidate_base"); fi
  done
  if (( ${#targets[@]} != 1 )); then
    echo 'Specify exactly which installed Mi Pad 2 kernel package to sign' >&2
    exit 1
  fi
fi
for pkgbase in "${targets[@]}"; do
  case "$pkgbase" in
    linux-latte-cachyos|linux-latte-integrated|linux-latte-integrated-7-2) ;;
    *) echo 'Unsupported kernel package base' >&2; exit 1 ;;
  esac
done

install_one_kernel() {
local pkgbase="$1"
local boot_image="/boot/vmlinuz-${pkgbase}"
local source_image tmp_image candidate
local -a owned_images matches

mapfile -t owned_images < <(
  pacman -Ql "${pkgbase}" \
    | awk '$2 ~ "^/usr/lib/modules/[^/]+/vmlinuz$" { print $2 }'
)

matches=()
for candidate in "${owned_images[@]}"; do
  [[ -s "${candidate}" ]] || continue
  matches+=("${candidate}")
done

if (( ${#matches[@]} != 1 )); then
  echo "Expected exactly one pacman-owned ${pkgbase} kernel image, found ${#matches[@]}" >&2
  printf 'Owned candidates: %s\n' "${owned_images[*]:-(none)}" >&2
  exit 1
fi

source_image="${matches[0]}"
if [[ "$pkgbase" == linux-latte-integrated && ! "$source_image" =~ /6\.14\.0-mipad2-integrated-r[0-9]+/vmlinuz$ ]]; then
  echo 'Integrated kernel package must contain a Linux6.14 integrated release' >&2
  exit 1
fi
if [[ "$pkgbase" == linux-latte-integrated-7-2 && ! "$source_image" =~ /7\.2\.0-mipad2-integrated-r[0-9]+/vmlinuz$ ]]; then
  echo 'Linux7.2 package must contain a Linux7.2 integrated release' >&2
  exit 1
fi
echo "Using $(pacman -Q "${pkgbase}") kernel image: ${source_image}"
tmp_image="${boot_image}.new"
trap 'rm -f "${tmp_image}"' EXIT

if [[ -s "${mok_key}" && -s "${mok_cert}" ]]; then
  /usr/bin/sbsign \
    --key "${mok_key}" \
    --cert "${mok_cert}" \
    --output "${tmp_image}" \
    "${source_image}"
  /usr/bin/sbverify --cert "${mok_cert}" "${tmp_image}" >/dev/null
  echo "Installed and signed ${source_image} -> ${boot_image}"
else
  install -m 0755 "${source_image}" "${tmp_image}"
  echo "No private MOK provisioned; installed unsigned kernel -> ${boot_image}"
fi

chmod 0755 "${tmp_image}"
mv -f "${tmp_image}" "${boot_image}"
trap - EXIT
}

declare -A completed=()
for pkgbase in "${targets[@]}"; do
  [[ -v "completed[$pkgbase]" ]] && continue
  install_one_kernel "$pkgbase"
  completed[$pkgbase]=1
done
