pkgname="virtualkeyboard-kcm"
pkgver="1.0.0"
pkgrel=1
pkgdesc="KDE Plasma Mobile Virtual Keyboard kcm"
arch=("x86_64")
url="https://invent.kde.org/plasma/plasma-mobile/-/tree/master/kcms/virtualkeyboard"
license=("GPL2")
depends=('maliit-keyboard')
makedepends=('extra-cmake-modules')
source=(
https://invent.kde.org/devinlin/maliit-keyboard-kcm/-/archive/master/maliit-keyboard-kcm-master.tar.gz
)
sha256sums=('SKIP')

prepare() {
    cd maliit-keyboard-kcm-master
    mkdir -p build
}

build() {
    cd maliit-keyboard-kcm-master/build

    cmake ../ \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    make
}

package() {
    cd maliit-keyboard-kcm-master/build
    make DESTDIR="$pkgdir" install
}