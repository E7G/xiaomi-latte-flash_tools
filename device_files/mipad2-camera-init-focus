#!/bin/sh
set -eu

NVMEM=/sys/bus/nvmem/devices/mipad2-t4ka3-otp/nvmem
STATE=/run/mipad2-camera-af.env

# The OTP provider is created by the T4KA3 module; give udev/module loading
# a short bounded window at boot, but never stay resident.
i=0
while [ ! -r "$NVMEM" ] && [ "$i" -lt 20 ]; do
    sleep 0.25
    i=$((i + 1))
done
[ -r "$NVMEM" ] || exit 0

# Xiaomi DW9761 OTP: big-endian infinity/macro words at raw offsets 0x13/0x15.
set -- $(od -An -tu1 -j 19 -N 4 "$NVMEM" 2>/dev/null)
[ "$#" -eq 4 ] || exit 0
inf=$(( $1 * 256 + $2 ))
macro=$(( $3 * 256 + $4 ))

# Reject corrupt / nonsensical calibration rather than moving the lens.
[ "$inf" -ge 0 ] && [ "$inf" -lt "$macro" ] && [ "$macro" -le 1023 ] || exit 1

focusdev=
for dev in /dev/v4l-subdev*; do
    [ -e "$dev" ] || continue
    if v4l2-ctl -d "$dev" --list-ctrls 2>/dev/null | grep -q 'focus_absolute'; then
        focusdev=$dev
        break
    fi
done
[ -n "$focusdev" ] || exit 0

# Even when the lens is runtime-suspended, V4L2 keeps the control value and
# the DW9719/DW9761 resume path restores it on next camera open.
v4l2-ctl -d "$focusdev" --set-ctrl="focus_absolute=$inf" >/dev/null

umask 022
cat > "$STATE" <<EOF
MIPAD2_AF_INFINITY=$inf
MIPAD2_AF_MACRO=$macro
MIPAD2_AF_DEVICE=$focusdev
EOF

printf 'Mi Pad 2 camera focus preset: infinity=%s macro=%s device=%s\n' "$inf" "$macro" "$focusdev"
