#!/bin/sh
set -eu

NVMEM=/sys/bus/nvmem/devices/mipad2-t4ka3-otp/nvmem
STATE=/run/mipad2-camera-af.env

# /run is populated by the root oneshot at boot and is the fast path for
# normal desktop launches. This also avoids requiring the logged-in user to
# have direct read permission on the NVMEM sysfs binary attribute.
inf=
macro=
focusdev=
if [ -r "$STATE" ]; then
    . "$STATE"
    inf=${MIPAD2_AF_INFINITY:-}
    macro=${MIPAD2_AF_MACRO:-}
    focusdev=${MIPAD2_AF_DEVICE:-}
fi

if [ -z "$inf" ] || [ -z "$macro" ]; then
    # T4KA3/AtomISP probe may finish a few seconds after multi-user.target.
    # Wait only inside this oneshot helper; nothing remains resident.
    i=0
    while [ ! -r "$NVMEM" ] && [ "$i" -lt 120 ]; do
        sleep 0.25
        i=$((i + 1))
    done
    [ -r "$NVMEM" ] || exit 1

    set -- $(od -An -tu1 -j 16 -N 16 "$NVMEM")
    [ "$#" -eq 16 ] || exit 2
    [ "$1" -eq 1 ] || exit 3

    sum=0
    stored=
    idx=1
    for x in "$@"; do
        if [ "$idx" -ge 2 ] && [ "$idx" -le 15 ]; then
            sum=$((sum + x))
        elif [ "$idx" -eq 16 ]; then
            stored=$x
        fi
        idx=$((idx + 1))
    done
    calc=$((sum % 255))
    [ -n "$stored" ] && [ "$calc" -eq "$stored" ] || exit 4

    inf=$(( $4 * 256 + $5 ))
    macro=$(( $6 * 256 + $7 ))
fi

case "$inf:$macro" in
    *[!0-9:]*|:|*: ) exit 5 ;;
esac
[ "$inf" -ge 0 ] && [ "$inf" -lt "$macro" ] && [ "$macro" -le 1023 ] || exit 5

# A devnode recorded earlier in this boot is preferred, but always verify it.
if [ -n "$focusdev" ] && {
    [ ! -e "$focusdev" ] ||
    ! v4l2-ctl -d "$focusdev" --list-ctrls 2>/dev/null | grep -q 'focus_absolute';
}; then
    focusdev=
fi
i=0
while [ -z "$focusdev" ] && [ "$i" -lt 40 ]; do
    for dev in /dev/v4l-subdev*; do
        [ -e "$dev" ] || continue
        if v4l2-ctl -d "$dev" --list-ctrls 2>/dev/null | grep -q 'focus_absolute'; then
            focusdev=$dev
            break
        fi
    done
    [ -n "$focusdev" ] || sleep 0.25
    i=$((i + 1))
done
[ -n "$focusdev" ] || exit 6

v4l2-ctl -d "$focusdev" --set-ctrl="focus_absolute=$inf" >/dev/null

# Only the boot-time root oneshot owns the persistent-in-/run state.
# Desktop launches reuse it read-only and must not fail trying to overwrite a
# root-owned file after successfully restoring the lens position.
if [ "$(id -u)" -eq 0 ]; then
    umask 022
    cat > "$STATE" <<EOF
MIPAD2_AF_INFINITY=$inf
MIPAD2_AF_MACRO=$macro
MIPAD2_AF_DEVICE=$focusdev
EOF
fi

printf 'Mi Pad 2 camera focus preset: infinity=%s macro=%s device=%s\n' "$inf" "$macro" "$focusdev"
