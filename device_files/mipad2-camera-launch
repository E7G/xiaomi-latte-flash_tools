#!/bin/sh
set -eu

mode=normal
case "${1:-}" in
    --no-autofocus)
        mode=normal
        shift
        ;;
    --autofocus)
        mode=fast
        shift
        ;;
    --full-autofocus)
        mode=full
        shift
        ;;
esac

# Always restore this tablet's factory infinity preset before opening the
# camera. The helper validates the rear-camera OTP AF group and writes a
# non-persistent state file for the C autofocus helper.
if command -v sudo >/dev/null 2>&1; then
    sudo -n /usr/local/sbin/mipad2-camera-init-focus >/dev/null 2>&1 || true
fi

# Normal launch stays immediate because GNOME Snapshot/PipeWire sees AtomISP as one camera node and may reopen the front V4L2 input regardless of a pre-launch rear-camera AF pass. Factory-range autofocus remains available through the explicit desktop actions; it runs before Snapshot opens AtomISP and leaves no daemon resident.
case "$mode" in
    fast)
        timeout 10s /usr/local/bin/mipad2-camera-af --fast >/tmp/mipad2-camera-af.log 2>&1 || true
        ;;
    full)
        timeout 30s /usr/local/bin/mipad2-camera-af --full >/tmp/mipad2-camera-af.log 2>&1 || true
        ;;
esac

exec snapshot "$@"
