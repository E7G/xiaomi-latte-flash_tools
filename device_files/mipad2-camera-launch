#!/bin/sh
set -eu

mode=fast
case "${1:-}" in
    --no-autofocus)
        mode=normal
        shift
        ;;
    --autofocus)
        mode=fast
        shift
        ;;
    --full-autofocus)
        mode=full
        shift
        ;;
esac

# Always restore this tablet's factory infinity preset before opening the
# camera. The helper validates the rear-camera OTP AF group and writes a
# non-persistent state file for the C autofocus helper.
if command -v sudo >/dev/null 2>&1; then
    sudo -n /usr/local/sbin/mipad2-camera-init-focus >/dev/null 2>&1 || true
fi

# Fast factory-range autofocus is the normal launch path. It runs before
# Snapshot opens the AtomISP node, then exits completely; no AF daemon stays
# resident. Never prevent Snapshot from opening if AF cannot run.
case "$mode" in
    fast)
        timeout 10s /usr/local/bin/mipad2-camera-af --fast >/tmp/mipad2-camera-af.log 2>&1 || true
        ;;
    full)
        timeout 30s /usr/local/bin/mipad2-camera-af --full >/tmp/mipad2-camera-af.log 2>&1 || true
        ;;
esac

exec snapshot "$@"
