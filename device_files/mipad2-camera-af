#!/usr/bin/env python3
import os, re, subprocess, tempfile, time
from pathlib import Path

VIDEO=os.environ.get("MIPAD2_CAMERA_VIDEO", "/dev/video0")
CALIB="/usr/local/sbin/mipad2-camera-calibration"
FALLBACK_INF=237
FALLBACK_MACRO=366

def run(args, check=True, capture=True):
    return subprocess.run(args, check=check, text=True,
                          stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
                          stderr=subprocess.PIPE if capture else subprocess.DEVNULL)

def read_calibration():
    try:
        out=run([CALIB]).stdout
        vals={}
        for line in out.splitlines():
            if "=" in line:
                k,v=line.split("=",1)
                vals[k]=v
        if vals.get("CALIBRATION_AVAILABLE") == "1":
            inf=int(vals["AF_INFINITY"])
            macro=int(vals["AF_MACRO"])
            if 0 <= inf < macro <= 1023:
                return inf,macro
    except Exception:
        pass
    return FALLBACK_INF,FALLBACK_MACRO

def rear_input():
    out=run(["v4l2-ctl","-d",VIDEO,"--list-inputs"]).stdout
    current=None
    candidates=[]
    for line in out.splitlines():
        m=re.match(r"\s*Input\s*:\s*(\d+)",line)
        if m:
            current=int(m.group(1))
            continue
        if current is not None and "t4ka3" in line.lower():
            candidates.append(current)
    if candidates:
        return candidates[0]

    # Older v4l2-ctl output may put the index and name on one line.
    for line in out.splitlines():
        m=re.search(r"^(\s*)(\d+)\s*[:=].*t4ka3",line,re.I)
        if m:
            return int(m.group(2))

    # Mi Pad 2 stable topology: OV5693=0, T4KA3=1.
    return 1

def focus_device():
    for dev in sorted(Path("/dev").glob("v4l-subdev*")):
        try:
            out=run(["v4l2-ctl","-d",str(dev),"--list-ctrls"]).stdout
        except Exception:
            continue
        if "focus_absolute" in out:
            return str(dev)
    raise RuntimeError("focus_absolute subdev not found")

def get_format():
    out=run(["v4l2-ctl","-d",VIDEO,"--get-fmt-video"]).stdout
    wh=re.search(r"Width/Height\s*:\s*(\d+)/(\d+)",out)
    sz=re.search(r"Size Image\s*:\s*(\d+)",out)
    if not (wh and sz):
        raise RuntimeError("cannot parse video format")
    return int(wh.group(1)),int(wh.group(2)),int(sz.group(1))

def set_focus(dev,pos):
    run(["v4l2-ctl","-d",dev,f"--set-ctrl=focus_absolute={pos}"])

def capture4(path):
    run(["v4l2-ctl","-d",VIDEO,"--stream-mmap=4","--stream-count=4",f"--stream-to={path}"])

def score_y(frame,w,h):
    y=frame[:w*h]
    # Center 75%, sparse 4-pixel grid. Standard-library-only edge energy.
    x0,x1=w//8,7*w//8
    y0,y1=h//8,7*h//8
    step=4
    total=0
    count=0
    for yy in range(y0+1,y1-1,step):
        row=yy*w
        up=(yy-1)*w
        dn=(yy+1)*w
        for xx in range(x0+1,x1-1,step):
            i=row+xx
            gx=int(y[i+1])-int(y[i-1])
            gy=int(y[dn+xx])-int(y[up+xx])
            total += gx*gx + gy*gy
            count += 1
    return total/count if count else 0.0

def measure(focus_dev,pos,w,h,frame_size,tmpdir):
    set_focus(focus_dev,pos)
    time.sleep(0.12)
    path=os.path.join(tmpdir,f"f-{pos}.raw")
    capture4(path)
    data=Path(path).read_bytes()
    n=len(data)//frame_size
    if n < 2:
        return 0.0
    scores=[]
    for fi in range(max(0,n-2),n):
        frame=data[fi*frame_size:(fi+1)*frame_size]
        scores.append(score_y(frame,w,h))
    return sum(scores)/len(scores)

def positions(lo,hi,step):
    p=list(range(lo,hi+1,step))
    if p[-1] != hi:
        p.append(hi)
    return p

def main():
    rear=rear_input()
    run(["v4l2-ctl","-d",VIDEO,f"--set-input={rear}"])
    lo,hi=read_calibration()
    focus_dev=focus_device()
    w,h,frame_size=get_format()
    print(f"rear_input={rear}, focus_dev={focus_dev}")
    print(f"AF range: {lo}..{hi}, video={w}x{h}, frame={frame_size}")

    # Start from the calibrated infinity end instead of an arbitrary 0..1023 value.
    set_focus(focus_dev,lo)
    time.sleep(0.15)

    with tempfile.TemporaryDirectory(prefix="mipad2-af-") as td:
        coarse_step=max(6,(hi-lo)//14)
        coarse=[]
        for p in positions(lo,hi,coarse_step):
            s=measure(focus_dev,p,w,h,frame_size,td)
            coarse.append((s,p))
            print(f"coarse {p}: {s:.2f}")

        _,best=max(coarse)
        fine_lo=max(lo,best-coarse_step)
        fine_hi=min(hi,best+coarse_step)
        fine=[]
        for p in positions(fine_lo,fine_hi,2):
            s=measure(focus_dev,p,w,h,frame_size,td)
            fine.append((s,p))
            print(f"fine {p}: {s:.2f}")

        score,best=max(fine)
        set_focus(focus_dev,best)
        print(f"BEST focus={best} score={score:.2f}")

if __name__=="__main__":
    main()
