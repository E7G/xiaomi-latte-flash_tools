#!/usr/bin/env python3
import gi, json, os, shutil, subprocess, tempfile
from pathlib import Path

gi.require_version("Gio", "2.0")
from gi.repository import Gio

SHELL_DIR = Path("/usr/share/gnome-shell")
LAYOUT_RES = SHELL_DIR / "gnome-shell-osk-layouts.gresource"
THEME_RES = SHELL_DIR / "gnome-shell-theme.gresource"
BACKUPS = Path("/var/backups/mipad2-osk")
BACKUPS.mkdir(parents=True, exist_ok=True)

def sh(*args):
    return subprocess.check_output(args, text=True).strip()

shell_version = sh("gnome-shell", "--version")
if not shell_version.startswith("GNOME Shell 50."):
    print(f"Mi Pad 2 OSK patch skipped: unsupported {shell_version}")
    raise SystemExit(0)

pkgver = sh("pacman", "-Q", "gnome-shell").split(maxsplit=1)[1].replace("/", "_")

def backup_path(res: Path):
    return BACKUPS / f"{res.name}.{pkgver}.stock"

def ensure_backup(res: Path):
    b = backup_path(res)
    if not b.exists():
        shutil.copy2(res, b)
    return b

def walk_resource(res, path="/"):
    out = []
    try:
        children = res.enumerate_children(path, Gio.ResourceLookupFlags.NONE)
    except Exception:
        return out
    for child in children:
        full = path + child
        if child.endswith("/"):
            out.extend(walk_resource(res, full))
        else:
            out.append(full)
    return out

def blob(res, path):
    return bytes(res.lookup_data(path, Gio.ResourceLookupFlags.NONE).get_data())

def compile_resource(files, prefix, target):
    with tempfile.TemporaryDirectory(prefix="mipad2-gres-") as td:
        root = Path(td)
        src = root / "src"
        src.mkdir()
        for rel, data in files.items():
            p = src / rel
            p.parent.mkdir(parents=True, exist_ok=True)
            p.write_bytes(data)

        xml = root / "resource.xml"
        names = sorted(files)
        xml.write_text(
            '<?xml version="1.0" encoding="UTF-8"?>\n'
            '<gresources>\n'
            f'  <gresource prefix="{prefix}">\n' +
            ''.join(f'    <file compressed="true">{n}</file>\n' for n in names) +
            '  </gresource>\n'
            '</gresources>\n',
            encoding="utf-8",
        )
        out = root / "out.gresource"
        subprocess.check_call([
            "glib-compile-resources",
            "--target", str(out),
            "--sourcedir", str(src),
            str(xml),
        ])
        shutil.copy2(out, target)

def replace_atomic(src, dst):
    new = dst.with_suffix(dst.suffix + ".new")
    shutil.copy2(src, new)
    os.chmod(new, 0o644)
    os.replace(new, dst)

# ---- Layout ----
# Always rebuild from the package-stock backup, so repeated runs do not
# compound width multipliers.
layout_base = ensure_backup(LAYOUT_RES)
res = Gio.Resource.load(str(layout_base))
prefix = "/org/gnome/shell/osk-layouts/"
files = {
    p[len(prefix):]: blob(res, p)
    for p in walk_resource(res)
    if p.startswith(prefix)
}

ext = json.loads(files["us-extended.json"].decode("utf-8"))

# Keep GNOME's native 4-row extended layout, but double all logical widths.
# Relative key proportions stay identical while AspectContainer sees a much
# wider layout and therefore stops shrinking it into the center of the tablet.
for level in ext.get("levels", []):
    rows = level.get("rows", [])
    if level.get("level") in ("default", "shift") and len(rows) != 4:
        raise RuntimeError(f"Unexpected stock row count in {level.get('level')}: {len(rows)}")
    for row in rows:
        for key in row:
            key["width"] = (key.get("width", 1)) * 2
            if "leftOffset" in key:
                key["leftOffset"] *= 2

us = json.loads(json.dumps(ext))
us["name"] = "English United States (Mi Pad 2 compact touch)"
ext["name"] = "English United States Extended (Mi Pad 2 compact touch)"
files["us.json"] = (json.dumps(us, ensure_ascii=False, indent=2) + "\n").encode()
files["us-extended.json"] = (json.dumps(ext, ensure_ascii=False, indent=2) + "\n").encode()

with tempfile.NamedTemporaryFile(delete=False) as tf:
    tmp = Path(tf.name)
try:
    compile_resource(files, prefix.rstrip("/"), tmp)
    test = Gio.Resource.load(str(tmp))
    for name in ("us.json", "us-extended.json"):
        obj = json.loads(blob(test, prefix + name).decode())
        levels = {x["level"]: x for x in obj["levels"]}
        assert len(levels["default"]["rows"]) == 4
        assert len(levels["shift"]["rows"]) == 4
        # Ensure default-width keys were actually widened.
        assert levels["default"]["rows"][0][1]["width"] == 2
    replace_atomic(tmp, LAYOUT_RES)
finally:
    tmp.unlink(missing_ok=True)

# ---- Theme ----
theme_base = ensure_backup(THEME_RES)
res = Gio.Resource.load(str(theme_base))
prefix = "/org/gnome/shell/theme/"
theme_files = {
    p[len(prefix):]: blob(res, p)
    for p in walk_resource(res)
    if p.startswith(prefix)
}

css_patch = """

/* Mi Pad 2 compact native OSK */
#keyboard .key-container {
  padding: 2px;
  spacing: 2px;
}
#keyboard .word-suggestions {
  spacing: 4px;
  min-height: 14pt;
  padding: 4px;
}
#keyboard .word-suggestions StButton {
  margin: 0 1px;
  min-width: 28px;
  padding: 3px 8px;
}
"""

for name in (
    "gnome-shell-dark.css",
    "gnome-shell-light.css",
    "gnome-shell-high-contrast.css",
):
    css = theme_files[name].decode("utf-8")
    theme_files[name] = (css + css_patch).encode()

with tempfile.NamedTemporaryFile(delete=False) as tf:
    tmp = Path(tf.name)
try:
    compile_resource(theme_files, prefix.rstrip("/"), tmp)
    test = Gio.Resource.load(str(tmp))
    css = blob(test, prefix + "gnome-shell-dark.css").decode()
    assert "Mi Pad 2 compact native OSK" in css
    replace_atomic(tmp, THEME_RES)
finally:
    tmp.unlink(missing_ok=True)

print("Mi Pad 2 compact GNOME OSK patch applied")
print("rows: 4")
print("logical key widths: 2x (same proportions, wider fill)")
print("key spacing/padding: 2px")
print("suggestion padding: 4px")
