#!/usr/bin/env python3
"""Reapply the Mi Pad 2 compact GNOME keyboard from a versioned stock backup."""
import argparse
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path, PurePosixPath
import re
import subprocess
import tempfile
import xml.etree.ElementTree as ET

SHELL_DIR = Path("/usr/share/gnome-shell")
BACKUPS = Path("/var/backups/mipad2-osk")
LAYOUT = "gnome-shell-osk-layouts.gresource"
THEME = "gnome-shell-theme.gresource"
LAYOUT_PREFIX = "/org/gnome/shell/osk-layouts/"
THEME_PREFIX = "/org/gnome/shell/theme/"
CSS_NAMES = ("gnome-shell-dark.css", "gnome-shell-light.css", "gnome-shell-high-contrast.css")
# Arch gnome-shell 1:51.1-1, verified against the official package signature.
ARCH_51_1 = {
    LAYOUT: "089e6a9031709169db4029b0fcbf51d61475f9aa5cf6fbd10357d0de675204bc",
    THEME: "b25f0023c8793144764fd80d6c3a08f69794c3387621292f84885c175a626f1e",
}
CSS_PATCH = b"""

/* Mi Pad 2 compact native OSK */
#keyboard .key-container {
  padding: 2px;
  spacing: 2px;
}
#keyboard .word-suggestions {
  spacing: 4px;
  min-height: 14pt;
  padding: 4px;
}
#keyboard .word-suggestions StButton {
  margin: 0 1px;
  min-width: 28px;
  padding: 3px 8px;
}
"""


def profile(shell_version, pkgver):
    if not re.fullmatch(r"[A-Za-z0-9:._+-]+", pkgver):
        raise ValueError("invalid gnome-shell package version")
    if shell_version.startswith("GNOME Shell 50."):
        return {}
    if shell_version == "GNOME Shell 51.1" and pkgver == "1:51.1-1":
        return ARCH_51_1
    return None


def read_resources(path):
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio
    resource = Gio.Resource.load(str(path))
    files = {}

    def walk(prefix):
        for child in resource.enumerate_children(prefix, Gio.ResourceLookupFlags.NONE):
            key = prefix + child
            if child.endswith("/"):
                walk(key)
            else:
                data = resource.lookup_data(key, Gio.ResourceLookupFlags.NONE)
                files[key] = bytes(data.get_data())

    walk("/")
    if not files:
        raise ValueError(f"empty GNOME archive: {path.name}")
    return files


def plan_layout(files):
    if LAYOUT_PREFIX + "us.json" not in files:
        raise ValueError("stock US layout is missing")
    ext = json.loads(files[LAYOUT_PREFIX + "us-extended.json"])
    if "Mi Pad 2 compact touch" in ext["name"]:
        raise ValueError("missing stock backup for an already patched layout")
    names = set()
    for rowset in ext["levels"]:
        level = rowset["level"]
        rows = rowset["rows"]
        if level in names or not isinstance(rows, list) or not rows:
            raise ValueError("unexpected extended layout levels")
        names.add(level)
        if level in ("default", "shift") and len(rows) != 4:
            raise ValueError(f"unexpected stock row count in {level}")
        for row in rows:
            if not isinstance(row, list) or not row:
                raise ValueError("empty extended layout row")
            for key in row:
                width = key.get("width", 1)
                if type(width) not in (int, float) or not math.isfinite(width) or width <= 0:
                    raise ValueError("invalid stock key width")
                key["width"] = width * 2
                if "leftOffset" in key:
                    offset = key["leftOffset"]
                    if type(offset) not in (int, float) or not math.isfinite(offset) or offset < 0:
                        raise ValueError("invalid stock key offset")
                    key["leftOffset"] = offset * 2
    if not {"default", "shift"} <= names:
        raise ValueError("missing extended layout levels")

    def serialize(name):
        ext["name"] = f"{name} (Mi Pad 2 compact touch)"
        return (json.dumps(ext, ensure_ascii=False, indent=2) + "\n").encode()

    return {**files,
            LAYOUT_PREFIX + "us.json": serialize("English United States"),
            LAYOUT_PREFIX + "us-extended.json": serialize("English United States Extended")}


def plan_theme(files):
    result = files.copy()
    for name in CSS_NAMES:
        key = THEME_PREFIX + name
        css = files[key]
        if CSS_PATCH in css or not all(x in css for x in (b"#keyboard", b".key-container", b".word-suggestions")):
            raise ValueError(f"unexpected stock theme in {name}")
        result[key] = css + CSS_PATCH
    return result


def compile_resource(files, scratch):
    src = scratch / "src"
    src.mkdir(parents=True)
    xml = ET.Element("gresources")
    node = ET.SubElement(xml, "gresource", prefix="/")
    for name, data in sorted(files.items()):
        p = PurePosixPath(name)
        if not p.is_absolute() or p.as_posix() != name or ".." in p.parts:
            raise ValueError(f"unexpected GResource entry: {name}")
        rel = Path(*p.parts[1:])
        target = src / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(data)
        ET.SubElement(node, "file", compressed="true").text = rel.as_posix()
    manifest = scratch / "resource.xml"
    ET.ElementTree(xml).write(manifest, encoding="UTF-8", xml_declaration=True)
    output = scratch / "output.gresource"
    subprocess.run(["glib-compile-resources", "--target", str(output), "--sourcedir", str(src),
                    str(manifest)], check=True)
    if read_resources(output) != files:
        raise ValueError("generated archive differs from the complete resource plan")
    return output.read_bytes()


def regular(path):
    if not path.is_file() or path.is_symlink():
        raise ValueError(f"expected regular resource: {path}")
    return path


def stock_plan(shell, backups, pkgver, pins):
    results = []
    for name, transform in ((LAYOUT, plan_layout), (THEME, plan_theme)):
        live = regular(shell / name)
        backup = backups / f"{name}.{pkgver}.stock"
        base = regular(backup) if backup.exists() or backup.is_symlink() else live
        original = base.read_bytes()
        if name in pins and hashlib.sha256(original).hexdigest() != pins[name]:
            raise ValueError(f"stock resource digest mismatch: {name}")
        files = read_resources(base)
        plan = transform(files)
        results.append((live, backup, original, files, plan))
    return results


def atomic_file(path, data):
    with tempfile.NamedTemporaryFile(dir=path.parent, prefix=f".{path.name}.", delete=False) as f:
        scratch = Path(f.name)
        try:
            f.write(data)
            f.flush()
            os.fchmod(f.fileno(), 0o644)
            os.fsync(f.fileno())
        except BaseException:
            scratch.unlink(missing_ok=True)
            raise
    try:
        os.replace(scratch, path)
    finally:
        scratch.unlink(missing_ok=True)


def apply(shell, backups, shell_version, pkgver, verify_only=False):
    pins = profile(shell_version, pkgver)
    if pins is None:
        if verify_only:
            raise ValueError(f"OSK not qualified for {shell_version} ({pkgver})")
        print(f"Mi Pad 2 OSK patch skipped: unsupported {shell_version} ({pkgver})")
        return False
    if verify_only:
        for live, backup, _, _, plan in stock_plan(shell, backups, pkgver, pins):
            if not backup.is_file() or read_resources(live) != plan:
                raise ValueError(f"compact OSK not applied: {live.name}")
        print("Mi Pad 2 compact GNOME OSK verified")
        return True

    if backups.is_symlink():
        raise ValueError("unsafe stock backup directory")
    backups.mkdir(mode=0o700, parents=True, exist_ok=True)
    flags = os.O_CREAT | os.O_WRONLY | os.O_NOFOLLOW
    with os.fdopen(os.open(backups / ".lock", flags, 0o600), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        plans = stock_plan(shell, backups, pkgver, pins)
        # Validate and compile both complete archives before either live swap.
        with tempfile.TemporaryDirectory(prefix="mipad2-osk-") as name:
            pending = []
            for live, backup, original, stock, plan in plans:
                installed = read_resources(live)
                if installed == plan:
                    continue
                if installed != stock:
                    raise ValueError(f"refusing to replace locally modified resource: {live.name}")
                new = compile_resource(plan, Path(name) / live.name)
                pending.append((live, backup, original, live.read_bytes(), new))
        swapped = []
        try:
            for live, backup, original, old, new in pending:
                if not backup.exists():
                    atomic_file(backup, original)
                atomic_file(live, new)
                swapped.append((live, old))
        except BaseException:
            for live, old in reversed(swapped):
                atomic_file(live, old)
            raise
    print("Mi Pad 2 compact GNOME OSK applied (4 rows, 2x logical key widths)")
    return True


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--verify", action="store_true", help="check installed resources without writing")
    args = p.parse_args()
    try:
        version = subprocess.check_output(["gnome-shell", "--version"], text=True).strip()
        _, pkgver = subprocess.check_output(["pacman", "-Q", "gnome-shell"], text=True).strip().split(maxsplit=1)
        apply(SHELL_DIR, BACKUPS, version, pkgver, args.verify)
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError) as exc:
        p.exit(1, f"Mi Pad 2 OSK: {exc}\n")


if __name__ == "__main__":
    main()
